# Postgres
DATABASE_URL=postgresql+asyncpg://owl:owl@localhost:5432/owl

# S3 / MinIO (local dev defaults match docker-compose.yml)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=owl-files
S3_USE_SSL=false

# Keycloak (OIDC) — must match the token issuer ("iss") and audience ("aud") claims exactly.
# "aud" defaults to "account" unless the client has an explicit audience mapper configured.
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/owl
KEYCLOAK_AUDIENCE=account
KEYCLOAK_JWKS_CACHE_SECONDS=3600

# CORS — comma-separated origins allowed to call this API from the browser
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
# Local development only: answer Chrome's private-network preflight
CORS_ALLOW_PRIVATE_NETWORK=false

# Backend-only secret for encrypting infra secrets (S3 credentials in
# s3_presets/drive_storage_targets) — NOT the client's data-encryption key.
# Required before running migration 0005. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKEND_SECRET_KEY=

# Account activity (sign-ins, sessions). Behind N reverse proxies that each append to X-Forwarded-For set N, so that the
# client's address is read from the header; with 0 it is the address of the connection. Events are kept this many days.
TRUSTED_PROXY_HOPS=0
ACTIVITY_RETENTION_DAYS=365

# How much each user may store in Owload's own storage (the S3 presets), summed over the drives they own, in bytes (3 GiB). The same for
# everybody; change it and restart to change it for all. A user's own S3 is not held by it. A reservation of an upload that was never
# finished stops holding room after this many hours.
FREE_PLAN_STORAGE_BYTES=3221225472
UPLOAD_RESERVATION_HOURS=24

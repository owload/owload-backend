# Postgres
DATABASE_URL=postgresql+asyncpg://owl:owl@localhost:5432/owl

# S3 / MinIO (local dev defaults match docker-compose.yml)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=owl-files
S3_USE_SSL=false

# Keycloak (OIDC) — must match the token issuer ("iss") and audience ("aud") claims exactly.
# "aud" defaults to "account" unless the client has an explicit audience mapper configured.
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/owl
KEYCLOAK_AUDIENCE=account
KEYCLOAK_JWKS_CACHE_SECONDS=3600

# CORS — comma-separated origins allowed to call this API from the browser
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
# Local development only: answer Chrome's private-network preflight
CORS_ALLOW_PRIVATE_NETWORK=false

# Backend-only secret for encrypting infra secrets (S3 credentials in
# s3_presets/drive_storage_targets) — NOT the client's data-encryption key.
# Required before running migration 0005. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKEND_SECRET_KEY=
